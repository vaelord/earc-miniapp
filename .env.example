# Telegram BotFather token. Keep this secret; never use a VITE_ prefix for it.
TELEGRAM_BOT_TOKEN=123456:replace_with_your_bot_token

# Public community group username (the bot must be an admin in this group).
TG_COMMUNITY_CHAT_USERNAME=@EtherArchiveOfficial
# Or set the numeric ID, e.g. -1001234567890:
# TG_COMMUNITY_CHAT_ID=

# Current Cloudflare Quick Tunnel URL. Update it whenever the trycloudflare URL changes.
PUBLIC_BASE_URL=https://replace-with-current-tunnel.trycloudflare.com
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret_12345

# Decide the actual reward policy before launch. This is intentionally 0 until configured.
REFERRAL_POINTS_PER_JOIN=0
API_PORT=3001
VITE_COMMUNITY_GROUP_URL=https://t.me/EtherArchiveOfficial
